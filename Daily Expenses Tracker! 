print('Welcome to the Daily Expenses Tracker!')

print('\Menu:')
print('1. Add a new expense')
print('2. View all expense')
print('3. Calculate total and average of expense')
print('4. Clear all the expense')
print('5. Exit!')

expenses = []

while True:
    choice  = input('Enter the menu number:')
    
    if choice == '1':
        amount = int(input('Add the expenses'))
        expenses.append(amount)
        print('New expense added successfully!')
        
    elif choice == '2':
        if len(expenses) == '0':
            print('No expenses recorded yet!')
        else:
            print('Your expenses:')
            for i in range(len(expenses)):
                print(f'{i+1}. {expenses[i]}')
    
    elif choice == '3':
        if len(expenses) == 0:
            print('No expenses added yet!')
        else:
            total=0
            for expense in expenses:
                total += expense
                average= total/len(expenses)
                print(f'Total expenses: {total}')
                print(f'Average expenses: {average}')
    
    elif choice == '4':
        expenses =[]
        print('All expenses cleared successfully!')
        
    elif choice == '5':
        print('Exiting the Daily Expenses Tracker!')
        
    else:
        print('Invalid choice. Please try again!')
        
        